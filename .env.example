# MiniMax API credentials. Copy this file to .env and set the key.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_MODEL=music-3.0-free

# Local single-user identity. Every database and media query is still scoped
# by this tenant id so an auth layer can replace it later.
DEFAULT_TENANT_ID=local-user
ALLOW_TENANT_HEADER=false

API_PORT=8787
API_HOST=127.0.0.1
DATABASE_PATH=./data/music.db
AUDIO_STORAGE_PATH=./data/audio
